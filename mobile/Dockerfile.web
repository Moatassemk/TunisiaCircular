FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app
COPY pubspec.* ./
RUN flutter pub get
COPY . .
ARG MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ARG MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
ARG MAP_TILE_USER_AGENT=CLAC/1.0
ARG MAP_TILE_PROVIDER=osm
ARG MAP_TILE_API_KEY=
RUN flutter build web --release \
    --dart-define=MAP_TILE_URL_TEMPLATE=${MAP_TILE_URL_TEMPLATE} \
    "--dart-define=MAP_TILE_ATTRIBUTION=${MAP_TILE_ATTRIBUTION}" \
    --dart-define=MAP_TILE_USER_AGENT=${MAP_TILE_USER_AGENT} \
    --dart-define=MAP_TILE_PROVIDER=${MAP_TILE_PROVIDER} \
    --dart-define=MAP_TILE_API_KEY=${MAP_TILE_API_KEY}

FROM nginx:alpine
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
